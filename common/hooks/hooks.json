{
  "description": "Forgeloom: hard gate before every git commit (secret scan + dependency-scan).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-gate.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
